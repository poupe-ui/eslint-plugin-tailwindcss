{
  "name": "@poupe/eslint-plugin-tailwindcss",
  "version": "0.3.1",
  "type": "module",
  "description": "ESLint plugin for Tailwind CSS v4 with advanced linting rules",
  "author": "Alejandro Mery <amery@apptly.co>",
  "license": "MIT",
  "homepage": "https://github.com/poupe-ui/eslint-plugin-tailwindcss#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poupe-ui/eslint-plugin-tailwindcss.git"
  },
  "bugs": {
    "url": "https://github.com/poupe-ui/eslint-plugin-tailwindcss/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "tailwind",
    "tailwindcss",
    "tailwind-css",
    "css",
    "linting"
  ],
  "sideEffects": false,
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    },
    "./configs": {
      "import": "./dist/configs.mjs"
    },
    "./parser": {
      "import": "./dist/parser.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "clean": "rimraf dist node_modules",
    "dev:prepare": "unbuild --stub",
    "lint": "eslint --fix .",
    "lint:_pkg-pr-new": "eslint --fix package.json",
    "lint:check": "eslint .",
    "precommit": "run-s dev:prepare lint type-check build test",
    "prepack": "run-s lint:_pkg-pr-new build lint:check type-check test publint",
    "prepare": "cross-test -s dist/index.mjs || unbuild --stub",
    "publint": "publint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/core": "^1.1.1",
    "@eslint/css": "^1.1.0",
    "@eslint/css-tree": "^3.6.9",
    "tailwind-csstree": "^0.3.0"
  },
  "devDependencies": {
    "@kagal/cross-test": "^0.1.3",
    "@poupe/eslint-config": "^0.10.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.4",
    "npm-run-all2": "^9.0.0",
    "pkg-pr-new": "~0.0.66",
    "publint": "^0.3.18",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@eslint/css": "^1.1.0",
    "eslint": "^9.30.0"
  },
  "engines": {
    "node": ">= 20.19.0",
    "pnpm": ">= 10.30.3"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "publishConfig": {
    "access": "public"
  }
}
